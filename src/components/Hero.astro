---
---

<section
  id="inicio"
  class="relative flex items-center overflow-hidden"
  style="min-height: 100dvh;"
  aria-label="Sección de inicio"
>
  <!-- Imagen de fondo -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://imgs.search.brave.com/pHe9jNaiC3OFmlmp_e3wMAiozq6-Vcwohu0xpAW5SvA/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9zdGF0/aWMudmVjdGVlenku/Y29tL3N5c3RlbS9y/ZXNvdXJjZXMvdGh1/bWJuYWlscy8wNzIv/MjU4LzI2OS9zbWFs/bC9hbi1hcnJheS1v/Zi1iYWtlZC1nb29k/cy1pbi1hbi1lbGVn/YW50LWJha2VyeS1k/aXNwbGF5LWNhc2Ut/cGhvdG8uanBn"
      alt="Pan artesanal recién horneado en La Esperanza"
      class="w-full h-full object-cover"
      fetchpriority="high"
    />
    <!-- Gradiente asimétrico: más oscuro a la izquierda, más transparente a la derecha -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(105deg, rgba(38,26,20,0.88) 0%, rgba(60,42,33,0.72) 45%, rgba(60,42,33,0.30) 80%, rgba(60,42,33,0.10) 100%);"
      aria-hidden="true"
    ></div>
  </div>

  <!-- Contenido — alineado a la izquierda (layout asimétrico) -->
  <div class="relative z-10 container-main w-full pt-28 pb-20">
    <div class="max-w-xl">

      <!-- Etiqueta superior -->
      <span class="anim-fade-up delay-100 block text-xs font-bold tracking-[0.18em] uppercase text-white mb-5">
        Tradición artesanal desde 1995
      </span>

      <!-- Titular principal -->
      <h1
        class="anim-fade-up delay-200 font-bold text-white mb-6 leading-none"
        style="font-family: var(--font-display); font-size: clamp(2.6rem, 6vw, 4.5rem); letter-spacing: -0.02em;"
      >
        El sabor que<br />
        <span class="italic" style="color: var(--color-coffee-light);">te espera</span><br />
        cada mañana
      </h1>

      <!-- Descripción -->
      <p
        class="anim-fade-up delay-300 text-gray-300 mb-10 text-lg leading-relaxed"
        style="max-width: 48ch;"
      >
        Horneamos con ingredientes seleccionados de la región y recetas
        de familia para llevar a tu mesa el pan más fresco de
        Barrancabermeja.
      </p>

      <!-- CTAs -->
      <div class="anim-fade-up delay-400 flex flex-col sm:flex-row gap-4">
        <a href="#productos" class="btn-primary">
          Ver el menú
        </a>
        <a href="#contacto" class="btn-secondary">
          Cómo llegar
        </a>
      </div>

      <!-- Indicadores estadísticos -->
      <div class="anim-fade-up delay-500 flex gap-8 mt-14 pt-10 border-t border-white/15">
        <div>
          <p class="text-2xl font-bold text-white tabular-nums" style="font-family: var(--font-display);">30+</p>
          <p class="text-xs text-gray-400 uppercase tracking-wider mt-0.5">Años de tradición</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white tabular-nums" style="font-family: var(--font-display);">100%</p>
          <p class="text-xs text-gray-400 uppercase tracking-wider mt-0.5">Artesanal</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-white tabular-nums" style="font-family: var(--font-display);">Diario</p>
          <p class="text-xs text-gray-400 uppercase tracking-wider mt-0.5">Recién horneado</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Gradiente inferior de transición -->
  <div
    class="absolute bottom-0 w-full h-28 z-10 pointer-events-none"
    style="background: linear-gradient(to top, var(--color-cream) 0%, transparent 100%);"
    aria-hidden="true"
  ></div>

  <!-- Flecha de scroll -->
  <div
    class="anim-fade-in delay-600 absolute bottom-10 left-1/2 z-20 pointer-events-none"
    style="transform: translateX(-50%);"
    aria-hidden="true"
  >
    <div class="w-6 h-10 border-2 border-white/40 rounded-full flex items-start justify-center pt-1.5">
      <div
        class="w-1 h-2.5 bg-white/60 rounded-full"
        style="animation: scrollDot 2s ease-in-out infinite;"
      ></div>
    </div>
  </div>
</section>

<style>
  @keyframes scrollDot {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(6px); opacity: 0.4; }
  }
</style>
