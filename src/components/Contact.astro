---
---

<section
  id="contacto"
  class="py-32 bg-white relative overflow-hidden"
  aria-label="Información de contacto y ubicación"
>
  <!-- Patrón de fondo sutil -->
  <div
    class="absolute left-0 bottom-0 w-96 h-96 rounded-full opacity-[0.03] pointer-events-none"
    style="background: var(--color-coffee-light); filter: blur(50px);"
    aria-hidden="true"
  ></div>

  <div class="container-main">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-stretch">
      
      <!-- Info y Detalles de Contacto -->
      <div class="lg:col-span-5 flex flex-col justify-between reveal">
        <div>
          <span class="section-label">Visítanos</span>
          <h2
            class="text-4xl md:text-5xl font-bold mb-6 leading-tight"
            style="font-family: var(--font-display); color: var(--color-coffee-dark);"
          >
            Estaremos felices de recibirte
          </h2>
          <div class="divider-accent mb-8"></div>
          <p class="text-gray-500 text-lg leading-relaxed mb-10">
            Siente el aroma del pan recién horneado y disfruta de la calidez santandereana en nuestro acogedor local.
          </p>
        </div>

        <!-- Lista de tarjetas de información -->
        <div class="space-y-6">
          <!-- Dirección -->
          <div
            class="flex items-start gap-4 p-5 rounded-2xl bg-[--color-cream] border border-[--color-beige]/50"
            style="box-shadow: var(--shadow-sm);"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-[--color-coffee] shrink-0"
              style="background: rgba(199, 161, 122, 0.2);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-[--color-coffee-dark] uppercase tracking-wider mb-1">Nuestra Casa</h3>
              <p class="text-gray-600 text-base leading-relaxed">
                Cra. 25 #48-7<br />
                Barrancabermeja, Santander
              </p>
            </div>
          </div>

          <!-- Horario -->
          <div
            class="flex items-start gap-4 p-5 rounded-2xl bg-[--color-cream] border border-[--color-beige]/50"
            style="box-shadow: var(--shadow-sm);"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-[--color-coffee] shrink-0"
              style="background: rgba(199, 161, 122, 0.2);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-[--color-coffee-dark] uppercase tracking-wider mb-1">Horario de Atención</h3>
              <p class="text-gray-600 text-base leading-relaxed">
                Lunes a Sábado: 8:30 AM - 8:00 PM<br />
                Domingos y Festivos: 9:00 AM - 5:30 PM
              </p>
            </div>
          </div>

          <!-- Canales -->
          <div
            class="flex items-start gap-4 p-5 rounded-2xl bg-[--color-cream] border border-[--color-beige]/50"
            style="box-shadow: var(--shadow-sm);"
          >
            <div
              class="w-10 h-10 rounded-full flex items-center justify-center text-[--color-coffee] shrink-0"
              style="background: rgba(199, 161, 122, 0.2);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-sm text-[--color-coffee-dark] uppercase tracking-wider mb-1">Contacto Directo</h3>
              <p class="text-gray-600 text-base leading-relaxed">
                +57 324 551 3758<br />
                info@laesperanza.com.co
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Mapa / Mockup Asimétrico de Localización -->
      <div class="lg:col-span-7 relative h-[450px] lg:h-auto min-h-[400px] rounded-3xl overflow-hidden reveal">
        <!-- Imagen de Barrancabermeja / Localización de Unsplash de alta estética -->
        <img
          src="https://i.pinimg.com/1200x/25/8e/9a/258e9a1580a60e63a203a26446b723a0.jpg"
          alt="Atmósfera acogedora e interior de nuestra panadería en Barrancabermeja"
          class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
          loading="lazy"
        />

        <!-- Overlay oscurecedor elegante -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent" aria-hidden="true"></div>

        <!-- Botón interactivo flotante para Google Maps -->
        <div class="absolute inset-0 flex items-center justify-center p-6 text-center">
          <a
            href="https://maps.app.goo.gl/GnAbXxjBF7j3mPdZ7"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 bg-white text-[--color-coffee-dark] font-bold text-sm uppercase tracking-widest hover:bg-[--color-coffee-light] hover:text-white transition-all duration-300 shadow-2xl hover:scale-105"
            style="font-family: var(--font-body); letter-spacing: 0.1em;"
          >
            Abrir en Google Maps
          </a>
        </div>

        <!-- Información flotante inferior -->
        <div class="absolute bottom-6 left-6 right-6 z-10 text-white pointer-events-none hidden sm:block">
          <p class="text-xs uppercase tracking-widest text-[--color-coffee-light] font-bold mb-1">Ubicación Estratégica</p>
          <p class="text-lg font-bold" style="font-family: var(--font-display);">Frente al Parque de la Vida, Barrancabermeja</p>
        </div>
      </div>

    </div>
  </div>
</section>
