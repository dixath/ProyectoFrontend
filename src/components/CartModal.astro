---
---

<div id="cart-modal" class="fixed inset-0 hidden" style={`z-index: var(--z-overlay)`}>
  <!-- Backdrop -->
  <div
    id="cart-backdrop"
    class="absolute inset-0 bg-black/40 backdrop-blur-sm transition-opacity opacity-0"
  ></div>

  <!-- Panel deslizable -->
  <div
    id="cart-panel"
    class="absolute inset-y-0 right-0 w-full max-w-md bg-[--color-cream] shadow-2xl flex flex-col"
    style="transform: translateX(100%); transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);"
  >
    <!-- Encabezado -->
    <div class="px-6 py-5 flex items-center justify-between border-b border-[--color-beige]">
      <h2 class="text-2xl font-bold text-[--color-coffee-dark]" style="font-family: var(--font-display);">
        Tu pedido
      </h2>
      <button
        id="close-cart-btn"
        aria-label="Cerrar carrito"
        class="p-2 text-gray-500 rounded-full transition-colors hover:text-[--color-coffee] hover:bg-[--color-beige]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Ítems del carrito -->
    <div id="cart-items" class="flex-1 overflow-y-auto p-6 space-y-4">
      <!-- Inyectado por JS -->
    </div>

    <!-- Footer con total y checkout -->
    <div class="p-6 border-t border-[--color-beige] bg-white">
      <div class="flex justify-between text-lg font-bold text-[--color-coffee-dark] mb-4">
        <span>Total</span>
        <span id="cart-total" data-price>$0</span>
      </div>
      <button
        id="checkout-btn"
        class="w-full py-4 px-4 bg-[#25D366] hover:bg-[#1da851] text-white text-center rounded-xl font-bold flex items-center justify-center gap-3 transition-all duration-200 hover:scale-[1.02] active:scale-95 shadow-md"
        aria-label="Confirmar pedido por WhatsApp"
      >
        <!-- Ícono WhatsApp SVG -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" />
        </svg>
        <span>Pedir por WhatsApp</span>
      </button>
      <p class="text-xs text-gray-500 text-center mt-3">
        Al confirmar, te llevaremos a WhatsApp para terminar tu pedido.
      </p>
    </div>
  </div>
</div>

<script>
  const modal      = document.getElementById('cart-modal')!;
  const backdrop   = document.getElementById('cart-backdrop')!;
  const panel      = document.getElementById('cart-panel')!;
  const closeBtn   = document.getElementById('close-cart-btn')!;
  const cartButton = document.getElementById('cart-button')!;
  const itemsEl    = document.getElementById('cart-items')!;
  const totalEl    = document.getElementById('cart-total')!;
  const checkoutBtn = document.getElementById('checkout-btn')!;

  // Número de WhatsApp — Colombia (sin +)
  const WHATSAPP_NUMBER = '573245513758';

  /* ─── Formato de precio en pesos colombianos ─── */
  const formatPrice = (price: number): string =>
    new Intl.NumberFormat('es-CO', {
      style: 'currency',
      currency: 'COP',
      maximumFractionDigits: 0,
    }).format(price);

  /* ─── Helpers de carrito ─── */
  const getCart = (): any[] =>
    JSON.parse(localStorage.getItem('esperanza_cart') || '[]');

  const saveCart = (cart: any[]): void => {
    localStorage.setItem('esperanza_cart', JSON.stringify(cart));
    window.dispatchEvent(new CustomEvent('cart-updated', { detail: cart }));
    renderCart();
  };

  /* ─── Abrir / cerrar ─── */
  const openCart = (): void => {
    modal.classList.remove('hidden');
    void modal.offsetWidth; // reflow
    backdrop.style.opacity = '1';
    panel.style.transform = 'translateX(0)';
    document.body.style.overflow = 'hidden';
    renderCart();
  };

  const closeCart = (): void => {
    backdrop.style.opacity = '0';
    panel.style.transform = 'translateX(100%)';
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  };

  /* ─── Renderizado del carrito ─── */
  const renderCart = (): void => {
    const cart = getCart();

    if (cart.length === 0) {
      itemsEl.innerHTML = `
        <div class="h-full flex flex-col items-center justify-center gap-4 text-gray-400 py-16">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-14 w-14 opacity-40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <div class="text-center">
            <p class="text-base font-medium text-gray-600">Tu carrito está vacío</p>
            <p class="text-sm text-gray-400 mt-1">Agrega algo del menú para empezar</p>
          </div>
        </div>`;
      totalEl.textContent = formatPrice(0);
      checkoutBtn.style.opacity = '0.4';
      checkoutBtn.style.pointerEvents = 'none';
      return;
    }

    checkoutBtn.style.opacity = '1';
    checkoutBtn.style.pointerEvents = 'auto';

    let html = '';
    let total = 0;

    cart.forEach((item: any) => {
      total += item.price * item.quantity;
      html += `
        <div class="flex items-center gap-4 bg-white p-3 rounded-xl border border-gray-100" style="box-shadow: var(--shadow-sm);">
          <img
            src="${item.image}"
            alt="${item.name}"
            class="w-16 h-16 object-cover rounded-lg shrink-0"
            loading="lazy"
          />
          <div class="flex-1 min-w-0">
            <h4 class="font-semibold text-gray-800 text-sm truncate">${item.name}</h4>
            <div class="text-[--color-coffee] font-bold text-sm mt-0.5" data-price>${formatPrice(item.price)}</div>
            <div class="flex items-center gap-3 mt-2">
              <button
                class="w-7 h-7 flex items-center justify-center rounded-full bg-[--color-beige] text-[--color-coffee] hover:bg-[--color-coffee-light] hover:text-white transition-colors font-bold text-base"
                onclick="window.updateQuantity('${item.id}', ${item.quantity - 1})"
                aria-label="Reducir cantidad de ${item.name}"
              >−</button>
              <span class="text-sm font-semibold w-5 text-center tabular-nums">${item.quantity}</span>
              <button
                class="w-7 h-7 flex items-center justify-center rounded-full bg-[--color-beige] text-[--color-coffee] hover:bg-[--color-coffee-light] hover:text-white transition-colors font-bold text-base"
                onclick="window.updateQuantity('${item.id}', ${item.quantity + 1})"
                aria-label="Aumentar cantidad de ${item.name}"
              >+</button>
            </div>
          </div>
          <button
            class="text-gray-300 hover:text-red-500 transition-colors p-2 shrink-0"
            onclick="window.removeFromCart('${item.id}')"
            aria-label="Eliminar ${item.name} del carrito"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </div>`;
    });

    itemsEl.innerHTML = html;
    totalEl.textContent = formatPrice(total);
  };

  /* ─── Métodos globales de carrito ─── */
  window.updateQuantity = (id: string, quantity: number): void => {
    if (quantity <= 0) {
      window.removeFromCart(id);
      return;
    }
    const cart = getCart();
    const item = cart.find((i: any) => i.id === id);
    if (item) {
      item.quantity = quantity;
      saveCart(cart);
    }
  };

  window.removeFromCart = (id: string): void => {
    saveCart(getCart().filter((i: any) => i.id !== id));
  };

  window.addToCart = (productStr: string): void => {
    const product = JSON.parse(productStr);
    const cart = getCart();
    const existing = cart.find((i: any) => i.id === product.id);
    if (existing) {
      existing.quantity += 1;
    } else {
      cart.push({ ...product, quantity: 1 });
    }
    saveCart(cart);
    openCart();
  };

  /* ─── Checkout a WhatsApp ─── */
  checkoutBtn.addEventListener('click', () => {
    const cart = getCart();
    if (cart.length === 0) return;

    let message = '*Hola, me gustaría hacer un pedido en La Esperanza*\n\n';
    message += '*Mi pedido:*\n';

    let total = 0;
    cart.forEach((item: any) => {
      message += `- ${item.quantity}x ${item.name} (${formatPrice(item.price * item.quantity)})\n`;
      total += item.price * item.quantity;
    });

    message += `\n*Total: ${formatPrice(total)}*\n\n`;
    message += '¿Pueden confirmarme la disponibilidad? ¡Gracias!';

    const encodedMessage = encodeURIComponent(message);
    window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`, '_blank');
  });

  /* ─── Eventos ─── */
  cartButton?.addEventListener('click', openCart);
  closeBtn?.addEventListener('click', closeCart);
  backdrop?.addEventListener('click', closeCart);

  // Tecla Escape cierra el carrito
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeCart();
    }
  });
</script>
