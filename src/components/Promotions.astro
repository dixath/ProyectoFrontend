---
---

<section
  id="promociones"
  class="py-28 relative overflow-hidden"
  style="background: var(--color-coffee-dark);"
  aria-label="Promociones del día"
>
  <!-- Patrón decorativo de fondo -->
  <div class="absolute inset-0 opacity-[0.06] pointer-events-none" aria-hidden="true">
    <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="promo-pattern" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M0 48L48 0H24L0 24M48 48V24L24 48" stroke="currentColor" stroke-width="1.5" fill="none" />
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#promo-pattern)" />
    </svg>
  </div>

  <!-- Glow ambiental izquierdo -->
  <div
    class="absolute -left-32 top-1/2 w-96 h-96 rounded-full pointer-events-none"
    style="background: radial-gradient(circle, rgba(199,161,122,0.15) 0%, transparent 70%); transform: translateY(-50%);"
    aria-hidden="true"
  ></div>

  <div class="container-main relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">

      <!-- Texto de la promoción -->
      <div class="text-white reveal">
        <!-- Badge de descuento -->
        <span
          class="inline-block px-3 py-1 mb-6 text-xs font-bold tracking-widest uppercase rounded"
          style="background: rgba(199,161,122,0.18); color: var(--color-coffee-light); border: 1px solid rgba(199,161,122,0.3);"
        >
          Promoción del día
        </span>

        <h2
          class="text-4xl md:text-5xl font-bold mb-4 leading-tight"
          style="font-family: var(--font-display); letter-spacing: -0.02em;"
        >
          Café + Rebanada<br />de Torta
        </h2>

        <p class="text-lg leading-relaxed mb-8" style="color: rgba(255,255,255,0.72); max-width: 44ch;">
          En la tarde, con cualquier rebanada de torta te llevas un café
          americano o tinto a mitad de precio. Una pausa que mereces.
        </p>

        <!-- Precios -->
        <div
          class="inline-flex items-center gap-5 px-6 py-5 rounded-2xl mb-8"
          style="background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); backdrop-filter: blur(8px);"
        >
          <div>
            <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">Precio promoción</p>
            <p class="text-3xl font-bold text-white tabular-nums" style="font-family: var(--font-display);">$12.000</p>
          </div>
          <div class="w-px self-stretch" style="background: rgba(255,255,255,0.15);"></div>
          <div>
            <p class="text-xs text-gray-400 uppercase tracking-wider mb-0.5">Precio normal</p>
            <p class="text-xl text-gray-500 line-through tabular-nums">$18.000</p>
          </div>
        </div>

        <!-- CTA -->
        <div class="block">
          <a href="#productos" class="btn-primary">
            Ver todos los productos
          </a>
        </div>
      </div>

      <!-- Imagen de la promoción -->
      <div class="relative reveal">
        <!-- Sombra decorativa detrás -->
        <div
          class="absolute inset-0 rounded-3xl"
          style="background: var(--color-coffee-light); opacity: 0.25; transform: rotate(3deg) scale(1.04);"
          aria-hidden="true"
        ></div>
        <img
          src="https://images.unsplash.com/photo-1559525839-b184a4d698c7?q=80&w=1000&auto=format&fit=crop"
          alt="Café y rebanada de torta — Promoción del día en La Esperanza"
          class="relative z-10 rounded-3xl object-cover w-full"
          style="height: 420px; box-shadow: 0 24px 64px rgba(0,0,0,0.35);"
          loading="lazy"
        />
        <!-- Etiqueta flotante de ahorro -->
        <div
          class="absolute -top-4 -right-4 z-20 w-20 h-20 rounded-full flex flex-col items-center justify-center text-center"
          style="background: var(--color-coffee-light); box-shadow: 0 8px 24px rgba(199,161,122,0.4);"
          aria-hidden="true"
        >
          <span class="text-xs font-bold text-white leading-tight">Ahorra</span>
          <span class="text-base font-bold text-white">33%</span>
        </div>
      </div>
    </div>
  </div>
</section>
